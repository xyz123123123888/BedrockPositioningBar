{
  "schemaVersion": 1,
  "id": "bedrockpositioningbar",
  "version": "${version}",
  "name": "BedrockPositioningBar",
  "description": "为 ViaFabricPlus 连接 Bedrock 服务器时提供玩家定位条（Locator Bar）显示。",
  "authors": ["魔汐"],
  "contact": {},
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.moxi.bedrockpositioningbar.client.BedrockPositioningBarClient"
    ]
  },
  "mixins": [
    "bedrockpositioningbar.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "viafabricplus": "*"
  }
}
